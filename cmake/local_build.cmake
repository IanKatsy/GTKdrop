# Bumps the local build counter (kept in the build folder, never in git) and writes local_build.cpp with it.
# Runs whenever a source file changed, so every build that compiles something gets a new number.
#   -DCOUNTER= -DOUT=

set(n 0)
if (EXISTS ${COUNTER})
    file(READ ${COUNTER} n)
    string(STRIP "${n}" n)
    if (NOT n MATCHES "^[0-9]+$")
        set(n 0)
    endif ()
endif ()
math(EXPR n "${n} + 1")
file(WRITE ${COUNTER} "${n}\n")
file(WRITE ${OUT} "// Generated by cmake/local_build.cmake. Don't edit.
// (declared in src/build_info.h)
extern const int gtkdrop_local_build = ${n};
")
