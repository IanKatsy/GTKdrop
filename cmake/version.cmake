# Writes version.h: MAJOR.MINOR from project(VERSION), the third part counted by git.
# Run on every build (cmake -P); the header only changes when the commit or the dirty state does.
#   -DMAJOR= -DMINOR= -DSOURCE_DIR= -DOUT=
#
# Build number = commits since the tag v<MAJOR>.<MINOR> (tag the commit that bumps the version), or every commit
# when that tag doesn't exist yet. 0 before the first commit.

set(build 0)
set(commit "nogit")
find_package(Git QUIET)
if (GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} describe --tags --long --match "v${MAJOR}.${MINOR}"
                    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE described RESULT_VARIABLE no_tag
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if (no_tag EQUAL 0 AND described MATCHES "-([0-9]+)-g[0-9a-f]+$")
        set(build ${CMAKE_MATCH_1})
    else ()
        execute_process(COMMAND ${GIT_EXECUTABLE} rev-list --count HEAD
                        WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE count RESULT_VARIABLE failed
                        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if (failed EQUAL 0)
            set(build ${count})
        endif ()
    endif ()
    execute_process(COMMAND ${GIT_EXECUTABLE} describe --always --dirty --abbrev=8 --match "NO-TAGS-WANTED"
                    WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE hash RESULT_VARIABLE failed
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if (failed EQUAL 0 AND hash)
        set(commit "g${hash}")
    endif ()
endif ()

set(text "// Generated by cmake/version.cmake on every build. Don't edit.
#pragma once
#define GTKDROP_VERSION \"${MAJOR}.${MINOR}.${build}\"
#define GTKDROP_COMMIT \"${commit}\"
")
file(CONFIGURE OUTPUT ${OUT}.tmp CONTENT "${text}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
file(REMOVE ${OUT}.tmp)
